# systemd unit of the test server: /etc/systemd/system/parapet.service
# One Node process serves the built client and the API; Caddy in front terminates TLS.
[Unit]
Description=Parapet (game client and leaderboard API)
Documentation=https://github.com/Gwynerva/parapet
After=network-online.target docker.service
Wants=network-online.target
# The bridge address appears only once Docker is up; never stop retrying until it does.
StartLimitIntervalSec=0

[Service]
Type=simple
User=parapet
Group=parapet
WorkingDirectory=/opt/parapet/current/packages/server
ExecStart=/usr/bin/node src/main.ts

Environment=NODE_ENV=production
# The Docker bridge of the Caddy container: reachable from Caddy, not from outside.
Environment=HOST=172.18.0.1
Environment=PORT=8787
Environment=ALLOWED_ORIGINS=https://parapet.gwynerva.net
Environment=DATA_DIR=/var/lib/parapet
Environment=STATIC_DIR=/opt/parapet/current/www

Restart=always
RestartSec=3

StateDirectory=parapet
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true

[Install]
WantedBy=multi-user.target
